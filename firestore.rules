rules_version = '2';
// Shaxsiy Moliya — Firestore qoidalari (Firebase loyihasi: moliya-tizimi-d1fd6)
// Firebase Console -> Firestore Database -> Rules bo'limiga to'liq nusxalab qo'ying va Publish bosing.
service cloud.firestore {
  match /databases/{database}/documents {
    // Har bir foydalanuvchi faqat o'z ma'lumotini o'qiydi va yozadi
    match /users/{uid}/kv/{key} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Boshqa hamma narsa yopiq
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
